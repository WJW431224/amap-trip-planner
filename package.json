{
  "name": "amap-trip-planner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,collab -c blue,green \"vite\" \"tsx watch server/collab-server.ts\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/collab-server.ts",
    "build": "tsc --noEmit && vite build && npm run build:server",
    "build:server": "esbuild server/collab-server.ts --bundle --platform=node --format=esm --target=node22 --outfile=server-dist/index.mjs --external:ws",
    "start": "node server-dist/index.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "^1.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
